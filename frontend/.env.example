# Backend API URL (change this to your deployed backend URL)
REACT_APP_BACKEND_URL=http://localhost:9001/mobile

# WebSocket port for development
WDS_SOCKET_PORT=9000

# VAPID public key for push notifications (generate with: web-push generate-vapid-keys)
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key-here

PUBLIC_URL=/mobile/app